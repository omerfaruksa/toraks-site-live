{
  "name": "torakslit",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "typecheck": "tsc -b --noEmit",
    "test:search": "node --experimental-strip-types tests/search.test.mts",
    "test:pipeline": "python3 -m unittest discover -s pipeline/tests",
    "check": "pnpm typecheck && pnpm test:search && pnpm test:pipeline && pnpm build",
    "pipeline:daily": "bash pipeline/run_daily.sh",
    "pipeline:report": "bash pipeline/run_weekly_report.sh"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.0"
  }
}
